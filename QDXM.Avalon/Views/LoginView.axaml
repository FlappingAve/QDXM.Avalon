<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:vm="using:QDXM.Avalon.ViewModels"
             x:Class="QDXM.Avalon.Views.LoginView"
             x:DataType="vm:LoginViewModel"
             x:CompileBindings="False">
  <Grid RowDefinitions="*,Auto,*" ColumnDefinitions="*,560,*" Margin="24">
    <Border Grid.Row="1" Grid.Column="1" Classes="panel" Padding="28">
      <StackPanel Spacing="18">
        <StackPanel Spacing="6">
          <TextBlock Text="Qobuz Login" FontSize="28" FontWeight="SemiBold" />
          <TextBlock Text="{Binding StatusText}"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Spacing="10">
          <Button Classes="primary"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center"
                  Command="{Binding BrowserLoginCommand}"
                  IsEnabled="{Binding IsNotBusy}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <ic:FluentIcon Icon="Globe"
                             IconVariant="Regular"
                             IconSize="Size20"
                             FontSize="18"
                             VerticalAlignment="Center" />
              <TextBlock Text="Sign in with Browser" />
            </StackPanel>
          </Button>

          <Button HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center"
                  Command="{Binding CancelBrowserLoginCommand}"
                  IsVisible="{Binding IsBrowserLoginActive}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <ic:FluentIcon Icon="Dismiss"
                             IconVariant="Regular"
                             IconSize="Size20"
                             FontSize="18"
                             VerticalAlignment="Center" />
              <TextBlock Text="Cancel Browser Login" />
            </StackPanel>
          </Button>
        </StackPanel>

        <Expander Header="Manual login"
                  HorizontalAlignment="Stretch">
          <StackPanel Spacing="14" Margin="0,14,0,0">
            <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="12">
              <TextBlock Grid.Row="0" Grid.Column="0" Text="User ID" Foreground="{DynamicResource TextSecondaryBrush}" />
              <TextBox Grid.Row="0" Grid.Column="1"
                       Text="{Binding UserId}"
                       IsEnabled="{Binding IsNotBusy}"
                       PlaceholderText="Required" />

              <TextBlock Grid.Row="1" Grid.Column="0" Text="Auth Token" Foreground="{DynamicResource TextSecondaryBrush}" />
              <TextBox Grid.Row="1" Grid.Column="1"
                       Text="{Binding UserAuthToken}"
                       IsEnabled="{Binding IsNotBusy}"
                       PasswordChar="*"
                       PlaceholderText="Required" />

              <TextBlock Grid.Row="2" Grid.Column="0" Text="App ID" Foreground="{DynamicResource TextSecondaryBrush}" />
              <TextBox Grid.Row="2" Grid.Column="1"
                       Text="{Binding AppId}"
                       IsEnabled="{Binding IsNotBusy}"
                       PlaceholderText="Optional" />

              <TextBlock Grid.Row="3" Grid.Column="0" Text="App Secret" Foreground="{DynamicResource TextSecondaryBrush}" />
              <TextBox Grid.Row="3" Grid.Column="1"
                       Text="{Binding AppSecret}"
                       IsEnabled="{Binding IsNotBusy}"
                       PlaceholderText="Optional" />
            </Grid>

            <Button HorizontalAlignment="Right"
                    Command="{Binding LoginCommand}"
                    IsEnabled="{Binding IsNotBusy}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Manual Login" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Expander>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
