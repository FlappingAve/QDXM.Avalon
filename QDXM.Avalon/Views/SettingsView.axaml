<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:vm="using:QDXM.Avalon.ViewModels"
             x:Class="QDXM.Avalon.Views.SettingsView"
             x:DataType="vm:SettingsViewModel"
             x:CompileBindings="False">
  <Grid>
    <ScrollViewer Margin="24">
      <StackPanel Spacing="18" MaxWidth="920">
        <TextBlock Text="Settings" FontSize="28" FontWeight="SemiBold" />

      <Border Classes="panel" Padding="18">
        <StackPanel Spacing="12">
          <TextBlock Text="Account and API" FontSize="18" FontWeight="SemiBold" />
          <Border Background="#15181b"
                  BorderBrush="{DynamicResource BorderQuietBrush}"
                  BorderThickness="1"
                  CornerRadius="5"
                  Padding="14">
            <Grid ColumnDefinitions="190,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="10">
              <TextBlock Grid.Row="0" Grid.Column="0" Text="Account" Foreground="{DynamicResource TextSecondaryBrush}" />
              <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding AccountName}" FontWeight="SemiBold" />
              <TextBlock Grid.Row="1" Grid.Column="0" Text="Email" Foreground="{DynamicResource TextSecondaryBrush}" />
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AccountEmail}" />
              <TextBlock Grid.Row="2" Grid.Column="0" Text="User Zone" Foreground="{DynamicResource TextSecondaryBrush}" />
              <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AccountZone}" />
              <TextBlock Grid.Row="3" Grid.Column="0" Text="Credential" Foreground="{DynamicResource TextSecondaryBrush}" />
              <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding AccountCredential}" />
              <TextBlock Grid.Row="4" Grid.Column="0" Text="Subscription" Foreground="{DynamicResource TextSecondaryBrush}" />
              <TextBlock Grid.Row="4" Grid.Column="1"
                         Text="{Binding AccountSubscription}"
                         TextWrapping="Wrap" />
            </Grid>
          </Border>
          <Grid ColumnDefinitions="190,*" RowDefinitions="Auto,Auto" RowSpacing="12">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="App ID" Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBlock Grid.Row="0" Grid.Column="1"
                       Text="{Binding AppIdDisplay}"
                       TextWrapping="Wrap" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="App Secret" Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBlock Grid.Row="1" Grid.Column="1"
                       Text="{Binding AppSecretDisplay}"
                       TextWrapping="Wrap" />
          </Grid>
          <TextBlock Text="Use Log out, then Log in to change account credentials."
                     Foreground="{DynamicResource TextSecondaryBrush}" />

          <Border Background="#15181b"
                  BorderBrush="{DynamicResource BorderQuietBrush}"
                  BorderThickness="1"
                  CornerRadius="5"
                  Padding="14">
            <StackPanel Spacing="12">
              <TextBlock Text="Preview Account" FontSize="16" FontWeight="SemiBold" />
              <TextBlock Text="{Binding PreviewCredentialStatus}"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         TextWrapping="Wrap" />

              <StackPanel Spacing="12"
                          IsVisible="{Binding IsPreviewLoggedOut}">
                <Button Classes="primary"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Command="{Binding BrowserPreviewLoginCommand}"
                        IsEnabled="{Binding IsPreviewNotBusy}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <ic:FluentIcon Icon="Globe"
                                   IconVariant="Regular"
                                   IconSize="Size20"
                                   FontSize="18"
                                   VerticalAlignment="Center" />
                    <TextBlock Text="Sign in Preview Account with Browser" />
                  </StackPanel>
                </Button>

                <Button HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Command="{Binding CancelPreviewBrowserLoginCommand}"
                        IsVisible="{Binding IsPreviewBrowserLoginActive}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <ic:FluentIcon Icon="Dismiss"
                                   IconVariant="Regular"
                                   IconSize="Size20"
                                   FontSize="18"
                                   VerticalAlignment="Center" />
                    <TextBlock Text="Cancel Preview Browser Login" />
                  </StackPanel>
                </Button>

                <Expander Header="Manual preview login"
                          HorizontalAlignment="Stretch">
                  <StackPanel Spacing="14" Margin="0,14,0,0">
                    <Grid ColumnDefinitions="190,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10">
                      <TextBlock Grid.Row="0" Grid.Column="0" Text="Preview User ID" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBox Grid.Row="0" Grid.Column="1"
                               Text="{Binding PreviewUserId, UpdateSourceTrigger=PropertyChanged}"
                               IsEnabled="{Binding IsPreviewNotBusy}"
                               PlaceholderText="Required" />

                      <TextBlock Grid.Row="1" Grid.Column="0" Text="Preview Auth Token" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBox Grid.Row="1" Grid.Column="1"
                               Text="{Binding PreviewUserAuthToken, UpdateSourceTrigger=PropertyChanged}"
                               IsEnabled="{Binding IsPreviewNotBusy}"
                               PasswordChar="*"
                               PlaceholderText="Required" />

                      <TextBlock Grid.Row="2" Grid.Column="0" Text="Preview App ID" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBox Grid.Row="2" Grid.Column="1"
                               Text="{Binding PreviewAppId, UpdateSourceTrigger=PropertyChanged}"
                               IsEnabled="{Binding IsPreviewNotBusy}"
                               PlaceholderText="Optional" />

                      <TextBlock Grid.Row="3" Grid.Column="0" Text="Preview App Secret" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBox Grid.Row="3" Grid.Column="1"
                               Text="{Binding PreviewAppSecret, UpdateSourceTrigger=PropertyChanged}"
                               IsEnabled="{Binding IsPreviewNotBusy}"
                               PasswordChar="*"
                               PlaceholderText="Optional" />
                    </Grid>

                    <Button HorizontalAlignment="Right"
                            Command="{Binding SavePreviewAccountCommand}"
                            IsEnabled="{Binding IsPreviewNotBusy}">
                      <TextBlock Text="Manual Preview Login" />
                    </Button>
                  </StackPanel>
                </Expander>
              </StackPanel>

              <StackPanel Spacing="12"
                          IsVisible="{Binding IsPreviewLoggedIn}">
                <Grid ColumnDefinitions="190,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="10">
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" Foreground="{DynamicResource TextSecondaryBrush}" />
                  <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PreviewAccountName}" TextWrapping="Wrap" />
                  <TextBlock Grid.Row="1" Grid.Column="0" Text="Email" Foreground="{DynamicResource TextSecondaryBrush}" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PreviewAccountEmail}" TextWrapping="Wrap" />
                  <TextBlock Grid.Row="2" Grid.Column="0" Text="Zone" Foreground="{DynamicResource TextSecondaryBrush}" />
                  <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PreviewAccountZone}" TextWrapping="Wrap" />
                  <TextBlock Grid.Row="3" Grid.Column="0" Text="Credential" Foreground="{DynamicResource TextSecondaryBrush}" />
                  <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PreviewAccountCredential}" TextWrapping="Wrap" />
                  <TextBlock Grid.Row="4" Grid.Column="0" Text="Subscription" Foreground="{DynamicResource TextSecondaryBrush}" />
                  <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding PreviewAccountSubscription}" TextWrapping="Wrap" />
                </Grid>
                <Button Classes="secondary"
                        HorizontalAlignment="Right"
                        Command="{Binding ClearPreviewAccountCommand}">
                  <TextBlock Text="Log out Preview Account" />
                </Button>
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>

      <Border Classes="panel" Padding="18">
        <StackPanel Spacing="12">
          <TextBlock Text="Downloads" FontSize="18" FontWeight="SemiBold" />
          <Grid ColumnDefinitions="190,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="12">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Download Folder" Foreground="{DynamicResource TextSecondaryBrush}" />
            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <TextBox Text="{Binding DownloadFolder, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="1"
                        Classes="secondary"
                        Click="BrowseDownloadFolder_OnClick"
                        MinWidth="110">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <ic:SymbolIcon Symbol="Folder"
                                   IconVariant="Regular"
                                   FontSize="18"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="Browse" />
                  </StackPanel>
                </Button>
              </Grid>
            </StackPanel>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Quality" Foreground="{DynamicResource TextSecondaryBrush}" />
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="16">
              <ComboBox Width="242"
                        ItemsSource="{Binding QualityOptions}"
                        SelectedItem="{Binding SelectedQuality}" />
              <CheckBox Content="MP3 Fallback"
                        VerticalAlignment="Center"
                        ToolTip.Tip="Use MP3 320 when Qobuz does not provide a FLAC file URL."
                        IsChecked="{Binding Settings.FallbackToMp3IfFlacUnavailable}" />
            </StackPanel>
            <TextBlock Grid.Row="2"
                       Grid.Column="0"
                       Text="Duplicate Files"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <ComboBox Grid.Row="2"
                      Grid.Column="1"
                      ItemsSource="{Binding DuplicateFileOptions}"
                      SelectedItem="{Binding Settings.DuplicateFileBehavior}"
                      ToolTip.Tip="Choose what happens when the final file already exists." />
            <TextBlock Grid.Row="3"
                       Grid.Column="0"
                       Text="Max File Name Length"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <StackPanel Grid.Row="3" Grid.Column="1" Spacing="4">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <NumericUpDown Value="{Binding MaxFileNameLengthValue}"
                               Width="112"
                               HorizontalAlignment="Left"
                               BorderBrush="{DynamicResource BorderSubtleBrush}"
                               Minimum="1"
                               Maximum="100"
                               Increment="1"
                               FormatString="0"
                               ClipValueToMinMax="False"
                               TextInput="MaxFileNameLength_OnTextInput" />
                <TextBlock Text="{Binding MaxFileNameLengthHelpText}"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource TextMutedBrush}" />
              </StackPanel>
              <TextBlock Text="{Binding MaxFileNameLengthErrorText}"
                         IsVisible="{Binding HasMaxFileNameLengthError}"
                         FontSize="12"
                         Foreground="IndianRed" />
            </StackPanel>
            <CheckBox Grid.Row="4"
                      Grid.Column="0"
                      Content="Save Cover Art"
                      IsChecked="{Binding Settings.SaveCoverArtFile}" />
            <ComboBox Grid.Row="4"
                      Grid.Column="1"
                      Width="242"
                      HorizontalAlignment="Left"
                      ItemsSource="{Binding ArtSizeOptions}"
                      SelectedItem="{Binding Settings.CoverArtSize}" />
            <CheckBox Grid.Row="5"
                      Grid.Column="0"
                      Content="Embed Cover Art"
                      IsChecked="{Binding Settings.Tagging.WriteCoverImageTag}" />
            <ComboBox Grid.Row="5"
                      Grid.Column="1"
                      Width="242"
                      HorizontalAlignment="Left"
                      ItemsSource="{Binding ArtSizeOptions}"
                      SelectedItem="{Binding Settings.Tagging.ArtSize}" />
            <CheckBox Grid.Row="6"
                      Grid.Column="0"
                      Grid.ColumnSpan="2"
                      Content="Save Goodies/Booklets"
                      IsChecked="{Binding Settings.DownloadGoodies}" />
          </Grid>
        </StackPanel>
      </Border>

      <Border Classes="panel" Padding="18">
        <StackPanel Spacing="12">
          <TextBlock Text="Protocol" FontSize="18" FontWeight="SemiBold" />
          <TextBlock Text="{Binding ProtocolStatusText}" Foreground="{DynamicResource TextSecondaryBrush}" />
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Classes="secondary" Command="{Binding RegisterProtocolCommand}" HorizontalAlignment="Left">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <ic:FluentIcon Icon="Link"
                               IconVariant="Regular"
                               IconSize="Size24"
                               FontSize="20"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="Register QDXMA Protocol" />
              </StackPanel>
            </Button>
            <Button Classes="secondary" Command="{Binding UnregisterProtocolCommand}" HorizontalAlignment="Left">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <ic:FluentIcon Icon="Delete"
                               IconVariant="Regular"
                               IconSize="Size24"
                               FontSize="20"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="Unregister QDXMA Protocol" />
              </StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>
      </StackPanel>
    </ScrollViewer>

    <Button Classes="primary"
            Command="{Binding SaveCommand}"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="0,0,24,24"
            MinWidth="120">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <ic:FluentIcon Icon="Save"
                       IconVariant="Regular"
                       IconSize="Size24"
                       FontSize="20"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
        <TextBlock Text="Save" />
      </StackPanel>
    </Button>
  </Grid>
</UserControl>
